# Pulselab - .gitignore

# AI agent framework (internal tooling, not part of the project)
.agent/
.agents/
skills-lock.json
dist-offline/

# Test directories and non-runtime test scripts
/tests/
!web/agent-simulator/tests/
supabase/tests/
Executar-Testes.bat

# Offline queue and student data (LGPD compliance)
.cache/

# Log files (operational, local only)
*.log
*.log.bak

# Environment / secrets
.env
*.env
instrutor/config.js
device_session.dat
tokens.json
*.dat
*firebase-adminsdk*.json
*-adminsdk-*.json

# Slide and presentation files
*.pptx
*.gs
texto_explicativo_slides_pulselab.md

# Temporary root archives
*.zip
*.zip.sha256
!instalador/downloads/*.zip
!instalador/downloads/*.zip.sha256

# OS artifacts
Thumbs.db
.DS_Store
desktop.ini

# Editor
.vscode/
*.code-workspace

# Python test/build artifacts
__pycache__/
*.py[cod]

# Web simulator build artifacts
node_modules/
dist/
.next/
.vinext/
.vite/
.wrangler/
.firebase/
web/agent-simulator/test-results/
web/agent-simulator/playwright-report/

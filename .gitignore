# Pulselab - .gitignore

# AI agent framework (internal tooling, not part of the project)
.agent/
scripts/git-cmd.ps1

# Offline queue and student data (LGPD compliance)
.cache/

# Log files (operational, local only)
*.log
*.log.bak

# Environment / secrets
.env
*.env
instrutor/config.js
device_session.dat
tokens.json
*.dat

# OS artifacts
Thumbs.db
.DS_Store
desktop.ini

# Editor
.vscode/
*.code-workspace

# Python test/build artifacts
__pycache__/
*.py[cod]

# Web simulator build artifacts
node_modules/
dist/
.next/
.vinext/
.vite/
.wrangler/
.firebase/

# Pulselab - .gitignore

# AI agent framework (internal tooling, not part of the project)
.agent/
.agents/
skills-lock.json
dist-offline/
dist-test/

# Local test scripts
Executar-Testes.bat

# Offline queue and student data (LGPD compliance)
.cache/

# Log files (operational, local only)
*.log
*.log.bak

# Environment / secrets
.env
*.env
instrutor/config.js
device_session.dat
tokens.json
*.dat
*firebase-adminsdk*.json
*-adminsdk-*.json

# Slide and presentation files
*.pptx
*.gs
texto_explicativo_slides_pulselab.md

# Temporary root archives
*.zip
*.zip.sha256

# OS artifacts
Thumbs.db
.DS_Store
desktop.ini

# Editor
.vscode/
*.code-workspace

# Python test/build artifacts
__pycache__/
*.py[cod]

# Build da PWA (npm run build em apps/student-pwa); vai no ZIP e no site, não no git
/alunos/

# Web simulator build artifacts
node_modules/
# Pacotes gerados (ZIP e .sha256); vão para as Releases do GitHub, não para o git
dist/
.next/
.vinext/
.vite/
.wrangler/
.firebase/
supabase/.temp/
apps/student-pwa/test-results/
apps/student-pwa/playwright-report/

# Offline research data storage (LGPD compliance), em qualquer pasta
dados_locais/

# Pasta montada por tooling/site/build-hosting.py para o Firebase Hosting
hosting-dist/
# Pacote montado para rodar localmente (tooling/dev)
dist-dev/
dist-polos/
dist-release/
*.pem

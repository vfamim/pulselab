# Pulselab - .gitignore

# AI agent framework (internal tooling, not part of the project)
.agent/

# Offline queue and student data (LGPD compliance)
.cache/

# Log files (operational, local only)
*.log
*.log.bak

# Environment / secrets
.env
*.env

# Generated standalone installer contains the Supabase anon key
Install-Pulselab*.bat

# OS artifacts
Thumbs.db
.DS_Store
desktop.ini

# Editor
.vscode/
*.code-workspace

# Python test/build artifacts
__pycache__/
*.py[cod]

# Web simulator build artifacts
node_modules/
dist/
.next/
.vinext/
.vite/
.wrangler/

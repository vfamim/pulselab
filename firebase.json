{
  "hosting": {
    "public": "hosting-dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.webmanifest",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/alunos/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/alunos/**",
        "destination": "/alunos/index.html"
      },
      {
        "source": "/simulador/**",
        "destination": "/alunos/index.html"
      },
      {
        "source": "/instalador/**",
        "destination": "/instalador/index.html"
      },
      {
        "source": "/tutorial/**",
        "destination": "/tutorial/index.html"
      },
      {
        "source": "/testes/**",
        "destination": "/testes/index.html"
      },
      {
        "source": "/lab/**",
        "destination": "/testes/index.html"
      }
    ]
  }
}

{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "agent/**",
      "bridge/**",
      "config/**",
      "dashboard/**",
      "dist-offline/**",
      "docs/**",
      "installer/**",
      "schema/**",
      "scripts/**",
      "simulador/**",
      "supabase/**",
      "tests/**",
      "tools/**",
      "web/**",
      "**/*.ps1",
      "**/*.bat",
      "**/*.cmd",
      "**/*.sh",
      "**/*.py",
      "**/*.sql",
      "**/*.exe"
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/alunos/**",
        "destination": "/alunos/index.html"
      },
      {
        "source": "/simulador/**",
        "destination": "/alunos/index.html"
      },
      {
        "source": "/instrutor/**",
        "destination": "/instrutor/index.html"
      },
      {
        "source": "/instalador/**",
        "destination": "/instalador/index.html"
      },
      {
        "source": "/tutorial/**",
        "destination": "/tutorial/index.html"
      },
      {
        "source": "/testes/**",
        "destination": "/testes/index.html"
      },
      {
        "source": "/lab/**",
        "destination": "/testes/index.html"
      }
    ]
  }
}

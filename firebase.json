{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "agent/**",
      "config/**",
      "dashboard/**",
      "docs/**",
      "installer/**",
      "schema/**",
      "tests/**",
      "web/**",
      "*.ps1",
      "*.bat",
      "*.py",
      "*.sql"
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/alunos/**",
        "destination": "/alunos/index.html"
      },
      {
        "source": "/simulador/**",
        "destination": "/simulador/index.html"
      },
      {
        "source": "/instrutor/**",
        "destination": "/instrutor/index.html"
      },
      {
        "source": "/instalador/**",
        "destination": "/instalador/index.html"
      },
      {
        "source": "/tutorial/**",
        "destination": "/tutorial/index.html"
      },
      {
        "source": "/testes/**",
        "destination": "/testes/index.html"
      },
      {
        "source": "/lab/**",
        "destination": "/testes/index.html"
      }
    ]
  }
}
